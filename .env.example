# AI
GEMINI_API_KEY=

# App
APP_URL=
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Stripe
STRIPE_SECRET_KEY=

# Firebase
FIREBASE_SERVICE_ACCOUNT=

# Admin access — comma-separated list of the Firebase account emails allowed into /admin
# and the coupon/order management endpoints
ADMIN_EMAILS=

# Instant order notifications (optional — set either or both)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Order delivery email — sent automatically (with the real source ZIP attached)
# when an admin marks an order as completed (optional; skipped safely if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Maps (client-side)
VITE_GOOGLE_MAPS_API_KEY=