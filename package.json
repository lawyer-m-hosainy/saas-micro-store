    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
